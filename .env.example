APP_ENV=development
PORT=8082
JWT_SECRET=change_me_to_a_long_random_string

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=kovio
DB_SSLMODE=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# Centrifugo
CENTRIFUGO_API_URL=http://localhost:8000/api
CENTRIFUGO_SECRET=change_me_centrifugo_hmac_secret
CENTRIFUGO_API_KEY=change_me_centrifugo_api_key

# License: Free/Pro catalog lives in DB (pricing_plans). Enforcement is currently OFF.
# See backend/internal/pkg/license/LICENSE_DEFERRED.md — set EnforcementEnabled=true later.
# Hosts cannot self-upgrade — only admins via /admin/license UI or:
#   PUT  /api/admin/license/plans/:id
#   POST /api/admin/license/assign  { "user_id", "plan_id", "ends_at_days"? }
# Fixed system admin (created on every API boot if missing)
SEED_ADMIN_EMAIL=admin@kovio.local
SEED_ADMIN_PASSWORD=KovioAdmin!2026
# Optional: force-reset admin password on boot
# SEED_ADMIN_RESET_PASSWORD=true

# Promote additional existing accounts to admin (comma-separated), then re-login:
ADMIN_EMAILS=

SEED_DEV_USER=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=

GIN_MODE=debug
